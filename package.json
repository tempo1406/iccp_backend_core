{
  "name": "iccp_be_core",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed": "cross-env NODE_ENV=prod ts-node -r tsconfig-paths/register src/database/seeds/index.ts",
    "seed:dev": "cross-env NODE_ENV=dev ts-node -r tsconfig-paths/register src/database/seeds/index.ts",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:create": "cross-env npm run typeorm -- migration:create",
    "migration:generate": "cross-env npm run typeorm -- --dataSource=src/database/data-source.ts migration:generate",
    "migration:generate:tables": "cross-env npm run typeorm -- --dataSource=src/database/data-source.ts migration:generate src/database/migrations/tables/Migration",
    "migration:run": "cross-env npm run typeorm -- --dataSource=src/database/data-source.ts migration:run",
    "migration:run:prod": "node ./node_modules/.bin/typeorm --dataSource=dist/database/data-source.js migration:run",
    "migration:run:local": "cross-env POSTGRE_DATABASE_HOST=localhost POSTGRE_DATABASE_PORT=5433 npm run migration:run",
    "migration:revert": "cross-env npm run typeorm -- --dataSource=src/database/data-source.ts migration:revert",
    "migration:revert:local": "cross-env POSTGRE_DATABASE_HOST=localhost POSTGRE_DATABASE_PORT=5433 npm run migration:revert",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:dev": "cross-env NODE_ENV=dev docker-compose --env-file .env.dev -f docker-compose.yaml up --build",
    "docker:prod": "cross-env NODE_ENV=prod docker-compose --env-file .env.prod -f docker-compose.prod.yaml up --build"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@keyv/redis": "^4.4.0",
    "@napi-rs/canvas": "^0.1.100",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.16",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.6",
    "@payos/node": "^2.0.5",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/nodemailer": "^6.4.17",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "argon2": "^0.43.0",
    "bullmq": "^5.74.1",
    "cache-manager": "^6.4.3",
    "cache-manager-ioredis": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.0",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "imagekit": "^6.0.0",
    "ioredis": "^5.6.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.24",
    "typeorm-transactional": "^0.5.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "path-to-regexp": "^8.4.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@configs/(.*)$": "<rootDir>/configs/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@exceptions/(.*)$": "<rootDir>/common/exceptions/$1",
      "^@utils/(.*)$": "<rootDir>/utils/$1",
      "^@middlewares/(.*)$": "<rootDir>/middlewares/$1",
      "^@guards/(.*)$": "<rootDir>/guards/$1",
      "^@decorators/(.*)$": "<rootDir>/common/decorators/$1",
      "^@database/(.*)$": "<rootDir>/database/$1",
      "^@constants/(.*)$": "<rootDir>/constants/$1",
      "^@enums/(.*)$": "<rootDir>/common/enums/$1",
      "^@types/(.*)$": "<rootDir>/common/types/$1",
      "^src/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/test-setup.ts"
    ]
  }
}
