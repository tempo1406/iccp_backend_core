# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-strong-password
GRAFANA_ROOT_URL=http://localhost:3000

# PostgreSQL Exporter (lấy từ .env của iccp_be_core)
POSTGRE_DATABASE_USERNAME=postgres
POSTGRE_DATABASE_PASSWORD=postgres
POSTGRE_DATABASE_NAME=iccp

# Redis Exporter (lấy từ .env của iccp_be_core)
REDIS_HOST=redis
REDIS_DATABASE_PORT=6379
REDIS_DATABASE_PASSWORD=
