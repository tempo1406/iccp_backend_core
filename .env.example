# ============================================
# ICCP Backend Core — Environment Variables
# ============================================
# Copy this file to .env.dev or .env.prod and fill in values

# App
NODE_ENV=dev
APP_PORT=3333
APP_NAME=ICCP BE Core
NAME='ICCP BE Core'
workingDirectory='/path/to/project'
FRONTEND_DOMAIN=http://localhost:5173
BACKEND_DOMAIN=http://localhost:3000
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-lang
APP_DEBUG=true

# API Docs (Swagger basic auth)
API_DOCS_USERNAME=admin
API_DOCS_PASSWORD=admin

# PostgreSQL
POSTGRE_DATABASE_HOST=postgres
POSTGRE_DATABASE_PORT=5432
POSTGRE_DATABASE_USERNAME=postgres
POSTGRE_DATABASE_PASSWORD=your_password_here
POSTGRE_DATABASE_NAME=iccp_be_core
POSTGRE_DATABASE_SYNCHRONIZE=false
POSTGRE_MIGRATION_TABLE_NAME=migrations
POSTGRES_SSL=false

# Redis
REDIS_HOST=redis
REDIS_USERNAME=default
REDIS_DATABASE_PORT=6379
REDIS_DATABASE_PASSWORD=your_redis_password_here
REDIS_TLS=false

# Chat box document preview
# Local/dev default when backend runs outside Docker
CHAT_BOX_OFFICE_PREVIEW_RENDERER_ENDPOINT=http://localhost:4010/api/render-office-preview

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE_IN=300000s
REFRESH_JWT_SECRET=your_refresh_jwt_secret_here
REFRESH_JWT_EXPIRE_IN=3000000s

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_IGNORE_TLS=false
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false

# OTP
OTP_EXPIRY_MINUTES=5

# ImageKit
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Default Avatar
DEFAULT_AVATAR_URL=https://ik.imagekit.io/your_id/default-avatar.png

# Internal service-to-service key (shared with iccp_be_ai)
INTERNAL_API_KEY=your_internal_api_key_here
